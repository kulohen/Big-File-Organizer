{
  "name": "big-file-organizer",
  "version": "1.0.0",
  "description": "将指定文件夹中大于阈值的文件归置到一级目录，其余文件和文件夹删除",
  "author": "big-file-organizer authors",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/big-file-organizer.git"
  },
  "keywords": [
    "electron",
    "file-manager",
    "cleanup",
    "windows"
  ],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "test": "node smoke-test.js"
  },
  "license": "MIT",
  "build": {
    "appId": "com.workbuddy.bigfileorganizer",
    "productName": "大文件管家",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-v${version}-便携版.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  }
}
